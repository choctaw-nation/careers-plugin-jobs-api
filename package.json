{
	"name": "careers-plugin-jobs-api",
	"version": "3.0.1",
	"description": "A WordPress plugin to display job listings from the Careers API.",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">= 24"
	},
	"author": "Choctaw Nation of Oklahoma",
	"files": [
		"build",
		"inc",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"careers-plugin-jobs-api.php",
		"vendor"
	],
	"scripts": {
		"build": "wp-scripts build",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix --allow-empty-input",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts build && wp-scripts plugin-zip",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@wordpress/api-fetch": "^7.50.0",
		"@wordpress/components": "^36.1.0",
		"@wordpress/dom-ready": "^4.50.0",
		"@wordpress/element": "^8.2.0",
		"@wordpress/eslint-plugin": "^25.6.0",
		"@wordpress/scripts": "^32.6.0",
		"eslint": "^9",
		"globals": "^17.7.0",
		"prettier": "npm:wp-prettier@^3",
		"stylelint": "^17.14.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.2.0",
		"typescript": "^6.0.3"
	}
}
